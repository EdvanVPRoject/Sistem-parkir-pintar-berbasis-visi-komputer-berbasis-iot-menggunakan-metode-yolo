# ====================================================================
# .gitignore - Sistem Parkir Pintar (Dual Authentication IoT + CV)
# ====================================================================

# 1. Kredensial & Kunci Rahasia (CRITICAL SECURITY)
kunci-firebase.json
config/kunci-firebase.json
*.pem
*.key
.env
.env.*

# 2. Database Lokal & Runtime Files
*.db
*.sqlite
*.sqlite3
data_parkir_unikom.db

# 3. Hasil Tangkapan Gambar & Debug Cache
hasil_capture/*.jpg
hasil_capture/*.jpeg
hasil_capture/*.png
!hasil_capture/.gitkeep
debug_ai_vision/
tes_font_output/

# 4. Dataset Mentah Ukuran Besar (Simpan di Google Drive / Kaggle)
dataset_plat/
dataset_seimbang/
Dataset_Bab4/
Analisis_Bab4/

# 5. Arsip Backup Kompresi
*.rar
*.zip
*.7z
*.tar.gz

# 6. Python Virtual Environment & Bytecode Cache
__pycache__/
*.py[cod]
*$py.class
env/
env_ta/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 7. IDE, Editor & OS Artefak
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 8. Firebase Hosting Temporary Cache
.firebase/
web_dashboard/.firebase/
